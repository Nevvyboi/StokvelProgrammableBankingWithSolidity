# /etc/stokvel/caddy.env, read by Caddy only. chmod 600.

# the name you pointed at the server in DNS (README step 3)
STOKVEL_DOMAIN=stokvel.example.com
# Let's Encrypt writes here if a certificate is about to expire
ACME_EMAIL=you@example.com

# the presenter panel's login. Make the hash on the server with:
#   caddy hash-password
# and paste the whole $2a$... string. Never the password itself.
PRESENTER_USER=presenter
PRESENTER_HASH=
