# The one door into the server. Caddy gets the HTTPS certificate on its own and decides, path by
# path, what the public may reach. The stage app, the relayer and the mock bank listen on
# 127.0.0.1 only, so this file is the whole of the public surface. deploy/README.md explains it.
#
# The values in {$...} come from /etc/stokvel/caddy.env (see caddy.env.example).

{
	email {$ACME_EMAIL}
}

{$STOKVEL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# No logins: a one-off talk, nothing real behind it, and the run sheet on the projector page
	# pulls the levers. The card keys are never on the server (DEMO_MODE=false).

	handle_path /relayer/* {
		reverse_proxy 127.0.0.1:4000
	}
	handle_path /mock/* {
		reverse_proxy 127.0.0.1:4100
	}
	# the stage app: the projector (/, with the run sheet), /sign, /watch and the read-only chain proxy (/api/rpc)
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
