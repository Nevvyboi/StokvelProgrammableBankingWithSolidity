# /etc/stokvel/stokvel.env, read by the stage app, the relayer and the mock bank. chmod 600.
# What is fixed for a public server (ports, 127.0.0.1, the proxy paths) is set in the unit files,
# not here, so it can't be forgotten.

# --------------------------------------------------------------- the chain
# Base Sepolia through a provider you hold a key for (Alchemy, QuickNode, Infura, ...). The key
# stays on the server: browsers read the chain through /api/rpc, never through this URL.
RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=84532

# Empty means "read contracts/deployments/84532.json", which the deploy script writes. Set these
# only if you deployed somewhere else.
STOKVEL_ADDRESS=
STOKVEL_V1_ADDRESS=

# Card 06b's address (cards/out/members.json, "spares" -> "06b"). Not secret: the presenter panel
# needs it to propose moving Sipho to the spare card in DEMO 8, and the card keys never reach the
# server.
SPARE_ADDRESS=

# --------------------------------------------------------------- the relayer's two keys
# Throwaway keys holding a little Base Sepolia ETH, never a key that holds anything real. Their
# addresses are the RELAYER and ATTESTOR you deployed the contract with.
RELAYER_PK=
ATTESTOR_PK=

# --------------------------------------------------------------- the bank
# mock: the mock Investec server on this box (the default, and what the talk rehearses with).
# sandbox: the real Investec sandbox; also fill in relayer/README.md's INVESTEC_* values here.
INVESTEC_MODE=mock
