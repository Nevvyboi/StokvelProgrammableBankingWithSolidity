{
  "name": "stokvel-relayer",
  "version": "1.0.0",
  "private": true,
  "description": "Carries messages between an Investec account and the Stokvel contract. It can't make decisions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "mock": "tsx src/mock/index.ts",
    "smoke:sandbox": "tsx scripts/sandbox-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "E2E=1 vitest run test/e2e.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
