# Copy to .env. Never commit .env.

# ---- chain ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# contracts/deployments/<chainId>.json is read when these are empty
STOKVEL_ADDRESS=
STOKVEL_V1_ADDRESS=
# Leave empty on Anvil: the relayer defaults to Anvil's public test accounts 1 and 2.
# On Base Sepolia set two throwaway keys the owner funds. Never a key that holds real value.
RELAYER_PK=
ATTESTOR_PK=

# ---- Investec ----
# mock: the stateful mirror in src/mock (default). sandbox: the real sandbox through the overlay
# proxy (npm run overlay, port 4200), which remembers what the sandbox accepts.
INVESTEC_MODE=mock
# Empty means :4100 in mock mode and :4200 in sandbox mode. Set it to
# https://openapisandbox.investec.com to talk to the stateless sandbox directly.
INVESTEC_BASE_URL=
# The overlay's own settings (npm run overlay)
OVERLAY_PORT=4200
OVERLAY_FILE=../.demo/sandbox-overlay.json
# Which sandbox accounts play the pool and the treasurer. Empty: the first two the sandbox lists.
POOL_ACCOUNT_ID=
TREASURER_ACCOUNT_ID=
# The public sandbox credentials from developer.investec.com (SA PB Account Information, "Sandbox").
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
# The stokvel's account. Leave empty to use the first account the API returns.
INVESTEC_ACCOUNT_ID=
INVESTEC_PROFILE_ID=
# pay: paymultiple to a saved beneficiary. transfer: transfermultiple between own accounts.
PAYOUT_METHOD=pay
# In mock mode, also send every payout to the real sandbox and log its answer. Needs the credentials above.
INVESTEC_SHADOW=none

# ---- loops ----
DEMO_MODE=true
POLL_MS=3000
RESERVES_MS=20000
# a JSON list mapping memberId to an Investec beneficiaryId or accountId, see members.example.json
MEMBERS_FILE=./members.example.json

# ---- http ----
PORT=4000
LOG_LEVEL=info
