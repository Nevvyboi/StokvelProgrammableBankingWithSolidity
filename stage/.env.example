NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
RELAYER_URL=http://127.0.0.1:4000
MOCK_URL=http://127.0.0.1:4100
# Base Sepolia: 84532, https://sepolia.basescan.org, and the deployed addresses (or leave them to contracts/deployments/84532.json)
STOKVEL_ADDRESS=
STOKVEL_V1_ADDRESS=
EXPLORER_URL=
INVESTEC_MODE=mock
# the presenter panel may sign as a member from cards/out/keys.json, on localhost only
DEMO_MODE=true
